{
  "manifest_version": 3,
  "name": "UYAP Haciz Yardımcısı",
  "version": "2.9.0",
  "description": "Seçili borçlu için EGM, icra dosyası, TAKBİS ve banka hacizlerini tek tuşla, toplu olarak hazırlar. Resmî bir UYAP ürünü değildir.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://avukat.uyap.gov.tr/*"
  ],
  "action": {
    "default_title": "UYAP Haciz Yardımcısı",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
